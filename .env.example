# Public site URL (production domain once purchased)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role bypasses RLS. Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/revalidate (header: x-revalidate-secret)
REVALIDATE_SECRET=

# Single allowlisted editor email (magic link)
ADMIN_EMAIL=

# Google Maps Platform — server-only. Enable Places API (legacy Place Autocomplete + Place Details).
# Used by admin Google Places lookup on /admin/places/[id] (Doc 11). Never expose to the client.
GOOGLE_MAPS_API_KEY=

# Optional — public Maps Embed key if you split keys later (Doc 11 §3.1). Prefer referrer-restricted.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional — Supabase CLI / account token (local only, never Vercel)
# SUPABASE_ACCESS_TOKEN=
